root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Java (Spotless / Google Java Format AOSP 4-space matching)
[*.java]
indent_style = space
indent_size = 4
continuation_indent_size = 8
ij_java_class_count_to_use_import_on_demand = 999
ij_java_names_count_to_use_import_on_demand = 999
ij_java_use_single_class_imports = true

# Python (FastAPI)
[*.py]
indent_style = space
indent_size = 4

# TypeScript / JavaScript / JSON (NestJS)
[*.{ts,js,json}]
indent_style = space
indent_size = 2

# Gradle / YAML / Markdown
[*.{gradle,yml,yaml,md}]
indent_style = space
indent_size = 2
